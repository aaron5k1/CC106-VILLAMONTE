rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 0. Global Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // --- Helpers ---
    function isSignedIn() {
      return request.auth != null;
    }

    function isEmailVerified() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function getUserData(uid) {
      return get(/databases/$(database)/documents/users/$(uid)).data;
    }

    function isAdmin() {
      return isSignedIn() && (getUserData(request.auth.uid).role == 'admin' || request.auth.token.email == 'aaronjamesvillamonte@gmail.com');
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // --- Validation Blueprints ---

    function isValidUser(data) {
      return data.keys().hasAll(['uid', 'email', 'role', 'displayName', 'createdAt']) &&
             data.uid == request.auth.uid &&
             data.email == request.auth.token.email &&
             data.role in ['member', 'admin'] &&
             data.displayName is string &&
             data.displayName.size() <= 100 &&
             data.createdAt == request.time;
    }

    function isValidBook(data) {
      return data.keys().hasAll(['title', 'author', 'quantity', 'availableCount', 'createdAt']) &&
             data.title is string && data.title.size() <= 255 &&
             data.author is string && data.author.size() <= 100 &&
             data.quantity is int && data.quantity >= 0 &&
             data.availableCount is int && data.availableCount >= 0 &&
             data.availableCount <= data.quantity &&
             data.createdAt == request.time;
    }

    function isValidLoan(data) {
      return data.keys().hasAll(['bookId', 'userId', 'borrowDate', 'dueDate', 'status']) &&
             isValidId(data.bookId) &&
             data.userId == request.auth.uid &&
             data.borrowDate == request.time &&
             data.dueDate is timestamp &&
             data.status == 'active';
    }

    // --- Match Rules ---

    // USERS
    match /users/{userId} {
      allow get: if isSignedIn();
      allow list: if isAdmin();
      allow create: if isOwner(userId) && isValidUser(incoming());
      allow update: if (isOwner(userId) && incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'photoURL'])) || isAdmin();
      allow delete: if isAdmin();
    }

    // BOOKS
    match /books/{bookId} {
      allow read: if isSignedIn();
      allow create, update, delete: if isAdmin() && isValidBook(incoming());
    }

    // LOANS
    match /loans/{loanId} {
      allow get: if isSignedIn() && (isOwner(existing().userId) || isAdmin());
      allow list: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isEmailVerified() && isValidLoan(incoming()) && 
                    get(/databases/$(database)/documents/books/$(incoming().bookId)).data.availableCount > 0;
      allow update: if (isSignedIn() && (isOwner(existing().userId) || isAdmin()) && 
                      incoming().diff(existing()).affectedKeys().hasOnly(['status', 'returnDate']) &&
                      incoming().status == 'returned' &&
                      incoming().returnDate == request.time) || isAdmin();
      allow delete: if isAdmin();
    }
  }
}
