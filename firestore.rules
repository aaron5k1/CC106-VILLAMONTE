rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 0. Global Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // --- Helpers ---
    function isSignedIn() {
      return request.auth != null;
    }

    function isEmailVerifiedOrAdmin() {
      return isSignedIn() && (request.auth.token.email_verified == true || isAdmin());
    }

    function getUserData(uid) {
      return get(/databases/$(database)/documents/users/$(uid)).data;
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.email == 'aaronjamesvillamonte@gmail.com' ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin')
      );
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // --- Validation Blueprints ---

    function isValidUser(data) {
      return data.keys().hasAll(['uid', 'email', 'role', 'displayName', 'createdAt']) &&
             data.uid == request.auth.uid &&
             data.email == request.auth.token.email &&
             data.role in ['member', 'admin'] &&
             data.displayName is string &&
             data.displayName.size() <= 100 &&
             data.createdAt == request.time;
    }

    function isValidBook(data) {
      return data.title is string && 
             data.author is string && 
             data.quantity is int && 
             data.availableCount is int;
    }

    function isValidLoan(data) {
      return data.bookId is string &&
             data.userId == request.auth.uid &&
             data.status in ['active', 'returned'];
    }

    function isValidReservation(data) {
      return data.bookId is string &&
             data.userId == request.auth.uid &&
             data.status in ['pending', 'cancelled', 'fulfilled', 'expired'];
    }

    // --- Match Rules ---

    // USERS
    match /users/{userId} {
      allow get: if isSignedIn();
      allow list: if isAdmin();
      allow create: if isOwner(userId);
      allow update: if isOwner(userId) || isAdmin();
      allow delete: if isAdmin();
    }

    // BOOKS
    match /books/{bookId} {
      allow read: if true;
      allow create, delete: if isAdmin();
      allow update: if isAdmin() || (
        isSignedIn() && 
        incoming().diff(existing()).affectedKeys().hasOnly(['availableCount']) &&
        (
          incoming().availableCount == existing().availableCount + 1 ||
          incoming().availableCount == existing().availableCount - 1
        )
      );
    }

    // LOANS
    match /loans/{loanId} {
      allow get: if isSignedIn() && (resource == null || resource.data.userId == request.auth.uid || isAdmin());
      allow list: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isSignedIn() && (incoming().userId == request.auth.uid || isAdmin()) && isValidLoan(incoming());
      allow update: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin()) && isValidLoan(incoming());
      allow delete: if isAdmin();
    }

    // RESERVATIONS
    match /reservations/{resId} {
      allow read: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isSignedIn() && (incoming().userId == request.auth.uid || isAdmin()) && isValidReservation(incoming());
      allow update: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin()) && (
                      incoming().diff(existing()).affectedKeys().hasOnly(['status']) &&
                      incoming().status in ['cancelled', 'fulfilled', 'expired']
                    );
      allow delete: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
    }
  }
}
